# Local disk-backed PostgreSQL. Never expose the embedded server to a network.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/benwa?connection_limit=1&pgbouncer=true&statement_cache_size=0
# For Supabase use a private direct/session-pooler connection; migrations use DIRECT_URL.
DIRECT_URL=
AGENT_MODE=demo
AUTONOMY_MODE=supervised
SEARCH_PROVIDER=public
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai-compatible
# Set LLM_PROVIDER=gemini to enable the router. Use a dedicated unbilled Free-tier project.
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_FREE_TIER_PROJECT_CONFIRMED=false
GEMINI_EXPERIMENTAL_GEMMA=false
# Optional model/group quota overrides; see docs/GEMINI.md. Defaults use your supplied limits.
GEMINI_QUOTAS_JSON={}
# This operator-provided cap must cover the model's context, not its advertised maximum.
LLM_MAX_INPUT_TOKENS=32000
LLM_MAX_OUTPUT_TOKENS=2400
# Research only visits exact approved public HTTPS hosts. Brave requires a key.
RESEARCH_HOSTS=developer.mozilla.org,en.wikipedia.org,docs.python.org
BRAVE_SEARCH_KEY=
LANGSEARCH_API_KEY=
FIRECRAWL_API_KEY=
# Enable only after consenting to send generated HTML to Firecrawl's isolated test browser.
FIRECRAWL_BROWSER_TESTS_ALLOWED=false
# Local safety ceilings, not provider-confirmed quotas. Firecrawl must report its free 1000-credit plan.
LANGSEARCH_DAILY_TOKEN_LIMIT=100000
FIRECRAWL_MONTHLY_CREDIT_LIMIT=900
WORKSPACE_ROOT=.data/projects
SANDBOX_IMAGE=benwa-sandbox:local
SUPERVISOR_STAGNANT_SECONDS=3600
SUPERVISOR_MAX_COST_PER_OUTCOME_MINOR=1000
# Required for any non-loopback HTTP deployment. Local cookie auth still applies.
DASHBOARD_PASSWORD=
SESSION_SECRET=
STRIPE_WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=4321
