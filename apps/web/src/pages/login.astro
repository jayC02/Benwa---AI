---
import '../styles/global.css';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Come in · Benwa</title></head><body><main class="login"><span class="brand-mark">b.</span><h1>Come into the workshop.</h1><p>Enter your dashboard password to check on Benwa.</p><form id="login"><label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required/><button class="primary">Open the workshop</button><p id="error" role="alert"></p></form></main><script>document.querySelector('form')?.addEventListener('submit',async e=>{e.preventDefault();const input=document.querySelector<HTMLInputElement>('#password');const r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:input?.value})});if(r.ok)location.href='/';else {const d=await r.json();document.querySelector('#error')!.textContent=d.error;}});</script></body></html>
